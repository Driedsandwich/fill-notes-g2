# Fill Notes server settings. Copy to `.env` (git-ignored) and fill in only what you use.
# Names only. Never commit real values.

# Where fills come from: replay (sample fills, default) | binance-testnet
FILL_SOURCE=replay
# Binance Spot TESTNET only (https://testnet.binance.vision). Never use mainnet keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_POLL_MS=2000

# Reason suggestions: rules (offline, default) | openai-compatible
REASONER=rules
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text for the hold-to-speak note: none (default) | openai-compatible
STT=none
STT_BASE_URL=
STT_API_KEY=

# Journal: jsonl (local, default) | notion
JOURNAL=jsonl
NOTION_TOKEN=
NOTION_DATABASE_ID=

DAILY_LOSS_LIMIT_USD=200
PORT=8787
REPLAY_FIRST_DELAY_MS=3000
REPLAY_INTERVAL_MS=20000
DATA_DIR=
